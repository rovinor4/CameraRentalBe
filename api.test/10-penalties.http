@baseUrl = http://localhost:8080

### Login admin biasa
# @name login_admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "rental@camera-rental.test",
  "password": "admin123"
}

### List penalties
GET {{baseUrl}}/api/penalties?page=0&size=10&search=damage&status=paid&start_date=2026-05-01&end_date=2026-05-31
Authorization: Bearer {{login_admin.response.body.data.token}}

### List penalties by return
GET {{baseUrl}}/api/returns/1/penalties
Authorization: Bearer {{login_admin.response.body.data.token}}

### Create penalty by return
POST {{baseUrl}}/api/returns/1/penalties
Authorization: Bearer {{login_admin.response.body.data.token}}
Content-Type: application/json

{
  "penalty_type": "late_return",
  "description": "Keterlambatan pengembalian 1 hari",
  "amount": 100000,
  "status": "unpaid",
  "paid_at": null
}

### Update penalty by return
PUT {{baseUrl}}/api/returns/1/penalties/1
Authorization: Bearer {{login_admin.response.body.data.token}}
Content-Type: application/json

{
  "penalty_type": "damage",
  "description": "Gores kecil pada body kamera",
  "amount": 50000,
  "status": "paid",
  "paid_at": "2026-05-12T17:00:00"
}

### Delete penalty by return
DELETE {{baseUrl}}/api/returns/1/penalties/2
Authorization: Bearer {{login_admin.response.body.data.token}}
