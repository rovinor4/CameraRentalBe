@baseUrl = http://localhost:8080

### Login admin biasa
# @name login_admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "rental@camera-rental.test",
  "password": "admin123"
}

### List payment details
GET {{baseUrl}}/api/payment-details?page=0&size=10&search=PAY&status=paid&start_date=2026-05-01&end_date=2026-05-31
Authorization: Bearer {{login_admin.response.body.data.token}}

### List payment details by rental
GET {{baseUrl}}/api/payment-details/rental/1
Authorization: Bearer {{login_admin.response.body.data.token}}

### List payment details by penalty
GET {{baseUrl}}/api/payment-details/penalty/1
Authorization: Bearer {{login_admin.response.body.data.token}}

### Create payment detail for rental
POST {{baseUrl}}/api/payment-details/rental/1
Authorization: Bearer {{login_admin.response.body.data.token}}
Content-Type: multipart/form-data; boundary=RentalPaymentCreateBoundary

--RentalPaymentCreateBoundary
Content-Disposition: form-data; name="payment_method_id"

1
--RentalPaymentCreateBoundary
Content-Disposition: form-data; name="amount"

350000
--RentalPaymentCreateBoundary
Content-Disposition: form-data; name="payment_date"

2026-05-22T13:30:00
--RentalPaymentCreateBoundary
Content-Disposition: form-data; name="status"

paid
--RentalPaymentCreateBoundary
Content-Disposition: form-data; name="proof_image"; filename="proof.jpg"
Content-Type: image/jpeg

< ./files/proof.jpg
--RentalPaymentCreateBoundary--

### Create payment detail for penalty
POST {{baseUrl}}/api/payment-details/penalty/1
Authorization: Bearer {{login_admin.response.body.data.token}}
Content-Type: application/json

{
  "payment_method_id": 1,
  "amount": 50000,
  "payment_date": "2026-05-22T15:00:00",
  "status": "paid",
  "proof_image": "rental-payments/manual-proof.jpg"
}

### Update payment detail tanpa upload baru, proof_image lama tetap dipakai
PUT {{baseUrl}}/api/payment-details/2
Authorization: Bearer {{login_admin.response.body.data.token}}
Content-Type: application/json

{
  "rental_id": 1,
  "payment_method_id": 1,
  "amount": 350000,
  "payment_date": "2026-05-22T14:00:00",
  "status": "paid",
  "proof_image": "rental-payments/uuid-proof.jpg"
}

### Delete payment detail
DELETE {{baseUrl}}/api/payment-details/4
Authorization: Bearer {{login_admin.response.body.data.token}}
