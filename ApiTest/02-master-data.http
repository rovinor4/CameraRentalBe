@baseUrl = http://localhost:8080

### Login super admin
# @name loginSuperAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@camera-rental.test",
  "password": "admin123"
}

### Login admin biasa
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "rental@camera-rental.test",
  "password": "admin123"
}

### Get customers with pagination
GET {{baseUrl}}/api/customers?page=0&size=10
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Search customers
GET {{baseUrl}}/api/customers?page=0&size=10&search=Budi
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Filter customers
GET {{baseUrl}}/api/customers?page=0&size=10&identityType=id_card&phone=0812
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Date filter customers
GET {{baseUrl}}/api/customers?page=0&size=10&startDate=2026-01-01&endDate=2026-12-31
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get customer by id
GET {{baseUrl}}/api/customers/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create customer
POST {{baseUrl}}/api/customers
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Dewi Lestari",
  "phone": "083344455566",
  "address": "Jl. Mawar No. 7, Depok",
  "identityType": "id_card",
  "identityNumber": "3275015505960004",
  "identityImage": "storage/identities/dewi-ktp.jpg"
}

### Update customer
PUT {{baseUrl}}/api/customers/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Budi Santoso Updated",
  "phone": "081234567890",
  "address": "Jl. Melati No. 12, Jakarta",
  "identityType": "id_card",
  "identityNumber": "3173010101900001",
  "identityImage": "storage/identities/budi-ktp.jpg"
}

### Delete customer
DELETE {{baseUrl}}/api/customers/4
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get categories
GET {{baseUrl}}/api/categories?page=0&size=10&search=Camera
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get category by id
GET {{baseUrl}}/api/categories/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Lighting",
  "description": "Lampu dan perlengkapan lighting"
}

### Update category
PUT {{baseUrl}}/api/categories/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Camera",
  "description": "Kamera untuk kebutuhan foto dan video profesional"
}

### Delete category
DELETE {{baseUrl}}/api/categories/4
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get category details
GET {{baseUrl}}/api/category-details?page=0&size=10&search=Mirrorless
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get category detail by id
GET {{baseUrl}}/api/category-details/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create category detail
POST {{baseUrl}}/api/category-details
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "categoryId": 3,
  "name": "Memory Card",
  "description": "Kartu memori dan storage"
}

### Update category detail
PUT {{baseUrl}}/api/category-details/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Mirrorless",
  "description": "Kamera mirrorless untuk foto dan video profesional"
}

### Delete category detail
DELETE {{baseUrl}}/api/category-details/7
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get items with search/filter/date/sort
GET {{baseUrl}}/api/items?page=0&size=10&search=Sony&status=available&startDate=2026-01-01&endDate=2026-12-31&sort=name&direction=asc
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get item by id
GET {{baseUrl}}/api/items/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create item
POST {{baseUrl}}/api/items
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "categoryId": 1,
  "categoryDetailId": 1,
  "name": "Fujifilm X-T5",
  "brand": "Fujifilm",
  "model": "X-T5",
  "serialNumber": "FUJI-XT5-001",
  "description": "Mirrorless APS-C high resolution",
  "dailyPrice": 225000,
  "stock": 2,
  "status": "available",
  "image": "storage/items/fuji-xt5.jpg"
}

### Update item
PUT {{baseUrl}}/api/items/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "categoryId": 1,
  "categoryDetailId": 1,
  "name": "Sony A7 III Updated",
  "brand": "Sony",
  "model": "A7 III",
  "serialNumber": "SONY-A7III-001",
  "description": "Full-frame mirrorless camera updated",
  "dailyPrice": 255000,
  "stock": 2,
  "status": "available",
  "image": "storage/items/sony-a7iii.jpg"
}

### Delete item
DELETE {{baseUrl}}/api/items/7
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get payment methods as super admin
GET {{baseUrl}}/api/payment-methods?page=0&size=10&search=Bank&type=bank_transfer
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get active payment methods as admin biasa
GET {{baseUrl}}/api/payment-methods?page=0&size=10
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get payment method by id
GET {{baseUrl}}/api/payment-methods/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create payment method
POST {{baseUrl}}/api/payment-methods
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Mandiri",
  "type": "bank_transfer",
  "contentType": "text",
  "contentValue": "Mandiri 9876543210 a.n Camera Rental",
  "active": true
}

### Update payment method
PUT {{baseUrl}}/api/payment-methods/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Cash",
  "type": "cash",
  "contentType": "text",
  "contentValue": "Bayar tunai di kasir",
  "active": true
}

### Delete payment method
DELETE {{baseUrl}}/api/payment-methods/5
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

