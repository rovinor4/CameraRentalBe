@baseUrl = http://localhost:8080

### Login super admin
# @name loginSuperAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@camera-rental.test",
  "password": "admin123"
}

### Login admin biasa
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "rental@camera-rental.test",
  "password": "admin123"
}

### Get rentals with pagination/search/filter/date
GET {{baseUrl}}/api/rentals?page=0&size=10&search=RNT&status=ongoing&startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get rental by id
GET {{baseUrl}}/api/rentals/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Create rental
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "customerId": 1,
  "rentalDate": "2026-05-22",
  "plannedReturnDate": "2026-05-24",
  "status": "pending",
  "note": "Sewa untuk demo request API",
  "details": [
    {
      "itemId": 3,
      "quantity": 1
    },
    {
      "itemId": 6,
      "quantity": 1
    }
  ]
}

### Update rental
PUT {{baseUrl}}/api/rentals/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "customerId": 1,
  "rentalDate": "2026-05-18",
  "plannedReturnDate": "2026-05-21",
  "status": "ongoing",
  "note": "Sewa untuk dokumentasi event kantor updated",
  "details": [
    {
      "itemId": 1,
      "quantity": 1
    },
    {
      "itemId": 6,
      "quantity": 1
    }
  ]
}

### Delete rental
DELETE {{baseUrl}}/api/rentals/3
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get rental payments
GET {{baseUrl}}/api/rental-payments?page=0&size=10&search=PAY&status=paid&startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get rental payment by id
GET {{baseUrl}}/api/rental-payments/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Create rental payment
POST {{baseUrl}}/api/rental-payments
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "rentalId": 1,
  "paymentMethodId": 1,
  "amount": 350000,
  "paymentDate": "2026-05-22T13:30:00",
  "status": "paid",
  "proofImage": "storage/proofs/pay-demo-new.jpg"
}

### Update rental payment
PUT {{baseUrl}}/api/rental-payments/2
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "rentalId": 1,
  "paymentMethodId": 1,
  "amount": 350000,
  "paymentDate": "2026-05-22T14:00:00",
  "status": "paid",
  "proofImage": "storage/proofs/pay-demo-002.jpg"
}

### Delete rental payment
DELETE {{baseUrl}}/api/rental-payments/4
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get returns
GET {{baseUrl}}/api/returns?page=0&size=10&search=RNT-DEMO&hasPenalty=true&startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get return by id
GET {{baseUrl}}/api/returns/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Create return
POST {{baseUrl}}/api/returns
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "rentalId": 1,
  "returnDate": "2026-05-24",
  "conditionNote": "Semua barang kembali lengkap",
  "hasPenalty": false,
  "penaltyPaymentMethodId": null
}

### Update return
PUT {{baseUrl}}/api/returns/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "rentalId": 2,
  "returnDate": "2026-05-12",
  "conditionNote": "Barang kembali lengkap, ada gores kecil pada body kamera",
  "hasPenalty": true,
  "penaltyPaymentMethodId": 1
}

### Delete return
DELETE {{baseUrl}}/api/returns/2
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get denda
GET {{baseUrl}}/api/denda?page=0&size=10&search=damage&status=paid&startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get denda by id
GET {{baseUrl}}/api/denda/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Create denda
POST {{baseUrl}}/api/denda
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "returnId": 1,
  "penaltyType": "late_return",
  "description": "Keterlambatan pengembalian 1 hari",
  "amount": 100000,
  "status": "unpaid",
  "paidAt": null
}

### Update denda
PUT {{baseUrl}}/api/denda/1
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "returnId": 1,
  "penaltyType": "damage",
  "description": "Gores kecil pada body kamera",
  "amount": 50000,
  "status": "paid",
  "paidAt": "2026-05-12T17:00:00"
}

### Delete denda
DELETE {{baseUrl}}/api/denda/2
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Get maintenance
GET {{baseUrl}}/api/maintenance?page=0&size=10&search=Kalibrasi&status=in_progress&startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Get maintenance by id
GET {{baseUrl}}/api/maintenance/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

### Create maintenance
POST {{baseUrl}}/api/maintenance
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "itemId": 2,
  "title": "Sensor cleaning",
  "description": "Pembersihan sensor dan pengecekan shutter",
  "maintenanceDate": "2026-05-25",
  "cost": 200000,
  "status": "in_progress"
}

### Update maintenance
PUT {{baseUrl}}/api/maintenance/1
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}
Content-Type: application/json

{
  "itemId": 5,
  "title": "Kalibrasi gimbal selesai",
  "description": "Kalibrasi motor dan pengecekan baterai selesai",
  "maintenanceDate": "2026-05-20",
  "cost": 150000,
  "status": "completed"
}

### Delete maintenance
DELETE {{baseUrl}}/api/maintenance/2
Authorization: Bearer {{loginSuperAdmin.response.body.data.token}}

